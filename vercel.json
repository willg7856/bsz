{
  "redirects": [
    {
      "source": "/contacts",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "missing": [
        { "type": "host", "value": "beyondstagezero.space" },
        { "type": "host", "value": "www.beyondstagezero.space" }
      ],
      "destination": "/index.html"
    }
  ]
}
